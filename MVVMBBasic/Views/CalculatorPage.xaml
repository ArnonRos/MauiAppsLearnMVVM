<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Views.CalculatorPage"
             Title="מחשבון">
    
    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

        <Label Text="מחשבון פשוט" 
               FontSize="28" 
               FontAttributes="Bold" 
               HorizontalOptions="Center" />

        <!-- תיבות קלט למספרים -->
        <Entry x:Name="Number1Entry" 
               Placeholder="הכנס מספר ראשון" 
               Keyboard="Numeric" 
               HeightRequest="48" />

        <Entry x:Name="Number2Entry" 
               Placeholder="הכנס מספר שני" 
               Keyboard="Numeric" 
               HeightRequest="48" />

        <!-- כפתורי פעולות החשבון -->
        <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10" HeightRequest="50">
            <Button Grid.Column="0" Text="+" Clicked="OnAddClicked" FontSize="20" />
            <Button Grid.Column="1" Text="-" Clicked="OnSubtractClicked" FontSize="20" />
            <Button Grid.Column="2" Text="*" Clicked="OnMultiplyClicked" FontSize="20" />
            <Button Grid.Column="3" Text="/" Clicked="OnDivideClicked" FontSize="20" />
        </Grid>
        
        <!-- הצגת התוצאה באמצעות Border המודרני -->
        <Border BackgroundColor="#F0F0F0" Padding="15" Margin="0,10,0,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5">
                <Label Text="התוצאה היא:" FontSize="20" FontAttributes="Bold" />
                <Label x:Name="ResultLabel" Text="0" FontSize="20" FontAttributes="Bold" TextColor="Green" />
            </HorizontalStackLayout>
        </Border>

    </VerticalStackLayout>
</ContentPage>