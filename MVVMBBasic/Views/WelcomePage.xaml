<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Views.WelcomePage"
             xmlns:vm="clr-namespace:ViewModels"
             x:DataType="vm:WelcomeViewModel"
             Title="{Binding Title}">

    <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

        <Label Text="ברוכים הבאים!"
               FontSize="28"
               FontAttributes="Bold"
               HorizontalOptions="Center" />

        <Label Text="בחרו מחשבון:"
               FontSize="18"
               HorizontalOptions="Center" />

        <!-- במקום Clicked: קישור ל-Command ב-ViewModel -->
        <Button Text="מחשבון גיל"
                Command="{Binding NavigateToCalcAgeCommand}"
                HeightRequest="48" />

        <Button Text="מחשבון מתמטי"
                Command="{Binding NavigateToCalculatorCommand}"
                HeightRequest="48" />

    </VerticalStackLayout>
</ContentPage>
